# Credenciais reais — nunca versionar (use .env.example como template)
.env

# Dados gerados pela ingestão (Bronze local) — reproduzível, não é código-fonte
data/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
venv/
.venv/

# Notebooks
.ipynb_checkpoints/

# Documentação de trabalho interna
docs/

# Apresentação HTML
apresentacao/

# Guias internos das stacks utilizadas (alinhamento do time, não é entrega)
stacks/

# Rascunhos de artigos para o Medium — conteúdo pessoal, não é entrega
artigos-medium/

# Artefatos de modelos treinados (binários grandes, reproduzíveis a partir do código)
models/artifacts/

# Artefatos locais do dbt (gerados por `dbt parse`/`dbt build`, não é código-fonte)
dbt/target/
dbt/logs/
dbt/.user.yml
